# Copia a .env y pon tu key real (el .env nunca se commitea)
META_API_KEY=tu-key-aqui
# Opcionales:
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# META_EMBED_MODEL=muse-spark-1.3   # override del modelo de embeddings en tests/smoke/smoke_meta_api.py
# DB_PASSWORD=lexdev   # postgres local (docker-compose)
# OLLAMA_MODEL=bge-m3  # embeddings locales (1024 dims)
# SECOP_APP_TOKEN=        # opcional: más límite en datos.gov.co
# Auth (Fase B): sin AUTH_JWT_SECRET se usa secreto de desarrollo (solo local).
# AUTH_JWT_SECRET=$(openssl rand -base64 48)  # ≥32 caracteres, producción obligatorio
# AUTH_ACCESS_TTL_MIN=15
# AUTH_REFRESH_TTL_DAYS=30
# AUTH_INACTIVITY_DAYS=7
# AUTH_MAX_SESSIONS=10
# AUTH_SECURE_COOKIES=false   # true en producción https
# APP_BASE_URL=http://localhost:4173
# TOTP (Fase C): sin TOTP_ENCRYPTION_KEY se usa clave de desarrollo (solo local).
# TOTP_ENCRYPTION_KEY=$(openssl rand -hex 32)  # 64 hex chars, producción obligatorio
# TOTP_WINDOW=1
# TOTP_STEP_SEC=30
# MFA_TOKEN_TTL_MIN=5
# Billing (Fase F): solo sandbox. Sin BILLING_WEBHOOK_SECRET usa dev (solo local).
# BILLING_PROVIDER=sandbox
# BILLING_WEBHOOK_SECRET=$(openssl rand -hex 32)
# Producción I1/I2 (2026-10-27): NODE_ENV=production exige secretos + SMTP,
# cookies seguras y CORS https; falla rápido al arrancar si falta algo.
# NODE_ENV=development   # development | test | production
# CORS_ORIGINS=https://app.lex.co,https://www.lex.co   # csv; prod exige https
# ALLOW_ANON_INVESTIGATE=false   # default: false en producción
# ADMIN_MFA_REQUIRED=true        # default: true en producción (admin exige 2FA)
# REDIS_URL=redis://redis:6379   # vacío = memoria (válido solo 1 réplica)
# SMTP_URL=smtp://usuario:clave@smtp.proveedor.com:587   # producción obligatorio
# SMTP_FROM=LexAgent <no-reply@lex.co>
