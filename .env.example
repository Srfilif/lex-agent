# Copia a .env y pon tu key real (el .env nunca se commitea)
META_API_KEY=tu-key-aqui
# Opcionales:
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# Embeddings (nombre + url + modelo + key del proveedor dedicado):
# EMBED_PROVIDER=gemini   # meta | ollama | gemini (default ollama)
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBED_MODEL=gemini-embedding-001   # 3072 dims, verificado 2026-11-04
# EMBED_API_KEY=tu-key-de-embeddings-aqui   # solo embeddings (Google AI Studio)
# META_EMBED_MODEL=muse-spark-1.3   # solo si EMBED_PROVIDER=meta (vacío = META_MODEL)
# OJO postgres: la columna vectorial sigue al proveedor (018 = 3072 gemini,
# pre-018 = 1024 ollama/bge-m3). Cambiar de proveedor exige migrar + re-ingerir.
# En sqlite (TEXT/JSON) cualquier dimensión funciona.
# DB_PASSWORD=lexdev   # postgres local (docker-compose)
# OLLAMA_MODEL=bge-m3  # embeddings locales (1024 dims, solo si EMBED_PROVIDER=ollama)
# Local sin Docker (npm run dev). Docker compose ignora estas 3 (usa las internas).
DATABASE_URL=postgres://lex:lexdev@localhost:5433/lexdb
PORT=3000
OLLAMA_HOST=http://localhost:11434
# Motor de DB: postgres (prod/docker) o sqlite (dev local sin Postgres).
# Con sqlite se ignora DATABASE_URL; migrate/seed/purge usan SQLITE_PATH.
DATABASE_PROVIDER=postgres
# DATABASE_PROVIDER=sqlite
# SQLITE_PATH=data/lexdb.sqlite
# Seed dev (npm run seed, rehusado en producción):
# usuario@lex.local / lex12345 (user) · admin@lex.local / admin12345 (admin)
# SECOP_APP_TOKEN=        # opcional: más límite en datos.gov.co
# Auth (Fase B): sin AUTH_JWT_SECRET se usa secreto de desarrollo (solo local).
# AUTH_JWT_SECRET=$(openssl rand -base64 48)  # ≥32 caracteres, producción obligatorio
# AUTH_ACCESS_TTL_MIN=15
# AUTH_REFRESH_TTL_DAYS=30
# AUTH_INACTIVITY_DAYS=7
# AUTH_MAX_SESSIONS=10
# AUTH_SECURE_COOKIES=false   # true en producción https
# APP_BASE_URL=http://localhost:4173
# TOTP (Fase C): sin TOTP_ENCRYPTION_KEY se usa clave de desarrollo (solo local).
# TOTP_ENCRYPTION_KEY=$(openssl rand -hex 32)  # 64 hex chars, producción obligatorio
# TOTP_WINDOW=1
# TOTP_STEP_SEC=30
# MFA_TOKEN_TTL_MIN=5
# Billing (Fase F): solo sandbox. Sin BILLING_WEBHOOK_SECRET usa dev (solo local).
# BILLING_PROVIDER=sandbox
# BILLING_WEBHOOK_SECRET=$(openssl rand -hex 32)
# Producción I1/I2 (2026-10-27): NODE_ENV=production exige secretos + SMTP,
# cookies seguras y CORS https; falla rápido al arrancar si falta algo.
# NODE_ENV=development   # development | test | production
# CORS_ORIGINS=https://app.lex.co,https://www.lex.co   # csv; prod exige https
# ALLOW_ANON_INVESTIGATE=false   # default: false en producción
# ADMIN_MFA_REQUIRED=true        # default: true en producción (admin exige 2FA)
# REDIS_URL=redis://redis:6379   # vacío = memoria (válido solo 1 réplica)
# SMTP_URL=smtp://usuario:clave@smtp.proveedor.com:587   # producción obligatorio
# SMTP_FROM=Kelsyx <no-reply@lex.co>
# Legal (frontend web): base de /terminos, /privacidad y /cookies (landing).
# VITE_LEGAL_URL=http://localhost:3001   # en producción: URL pública de la landing
# Acceso a la plataforma (ver docs/operaciones/ACCESS_MODES.md). Requiere reinicio.
# ACCESS_MODE=public   # public | maintenance | closed | whitelist | code (open = alias de public)
# ACCESS_WHITELIST=ana@uni.edu.co,*@empresa.co   # csv; unión con la BD
# ACCESS_CODE=KX-2026-DEMO   # código único estático (modo code); vacío = solo BD
